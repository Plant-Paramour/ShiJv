{
  "name": "南乡子",
  "aliases": [],
  "description": "唐教坊曲名。此词有单调、双调。单调者始自欧阳炯词，冯延巳、李珣俱本此添字。双调者始自冯延巳词。《太和正音谱》注“越调”。欧阳修本此减字，王之道、黄机、赵长卿俱本此添字也。",
  "default_variant": "欧阳炯",
  "default_variant_source_id": 58,
  "variants": [
    {
      "name": "欧阳炯",
      "source_id": 58,
      "length_category": "short",
      "variants_description": "此词单遍，平仄两韵，与宋人两段全押平韵者异。其可平可仄，即参谱内诸词。",
      "rhyme_type": "平仄转换韵",
      "number_of_stanzas": 1,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2
        ],
        "rhyme_2_positions": [
          3,
          4,
          5
        ],
        "lines": [
