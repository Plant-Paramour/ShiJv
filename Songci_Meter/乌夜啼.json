        "rhyme_1_positions": [
          2,
          4
        ],
        "lines": [
          "仄仄/平平仄",
          "中平/仄仄/平平",
          "中平/中仄/平平仄",
          "中仄/仄平平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          4
        ],
        "lines": [
          "中仄/中平/中仄",
          "中平/中仄/平平",
          "中平/中仄/平平仄",
          "中仄/仄平平"
        ]
      }
    },
    {
      "name": "赵令畤",
      "source_id": 407,
      "length_category": "short",
      "variants_description": "按此调五字起者或名《圣无忧》。六字起者或名《锦堂春》。宋人俱填《锦堂春》体，其实始于南唐李煜，本名《乌夜啼》也。《词律》反以《乌夜啼》为别名者误。惟《相见欢》一词，乃别名《乌夜啼》，与此无涉。\n此调前段起句六字，宋人皆同，惟苏轼词前后段第三句“若见故人须细问”、“更有鲈鱼堪切鲙”，平仄独异。前段第一句，卢祖皋词“柳色津头泫绿”，“柳”字仄声； 刘迎词“离恨远萦杨柳”，“远”字仄声，“杨”字平声。谱内据此，余参前词。",
      "rhyme_type": "平韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          2,
          4
        ],
        "lines": [
          "中仄/中平/中仄",
          "平平/仄仄/平平",
          "中中/中中/平中仄",
          "中仄/仄平平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          4
        ],
        "lines": [
          "仄仄/平平/仄仄",
          "平平/仄仄/平平",
          "中中/中中/平中/仄",
          "中仄/仄平平"
        ]
      }
    },
    {
      "name": "程垓",
      "source_id": 408,
      "length_category": "short",
      "variants_description": "此词前后段结句作三字两句异。汲古阁本《书舟词》误刻《西江月》，《词律》犹沿其误。今从《词纬》改定。至《词律》收程珌词，乃《锦帐春》，与《锦堂春》迥别，另编不列。",
      "rhyme_type": "平韵",
