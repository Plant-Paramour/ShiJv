{
  "name": "添声杨柳枝",
  "aliases": [],
  "description": "按《碧鸡漫志》云：“黄钟商有《杨柳枝》曲，仍是七言四句诗，与刘、白及五代诸子所制并同，但每句下各添三字一句，乃唐时和声，如《竹枝》、《渔父》，今皆有和声也。旧词多侧字起头，第三句亦复侧字起，声度差稳耳",
  "default_variant": "顾夐",
  "default_variant_source_id": 230,
  "variants": [
    {
      "name": "顾夐",
      "source_id": 230,
      "length_category": "short",
      "variants_description": "此词有唐宋两体。唐词换头句押仄韵，宋词换头句即押平韵。\n按张泌词前段起句“腻粉琼妆透碧纱”，“腻”字仄声。第三句“金凤搔头坠鬓斜”，平仄全异。后段起句“倚著云屏新睡觉”，“云”字平声。第二句“思梦笑”，“梦”字仄声。第三句“红腮隐出枕函花”，“红”字平声，“隐”字仄声。许棐词前段第三句“不知屏里画潇湘”，“不”字仄声。后段起句“重叠衾罗犹未暖”，“重” 字平声。此两词皆换头押仄韵者，故谱内可平可仄据之。",
      "rhyme_type": "平仄转换韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          3,
          4
        ],
        "lines": [
          "中仄/平平/仄仄平",
          "仄平平",
          "中中/平中/仄中平",
          "仄平平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          3,
          4
        ],
        "rhyme_2_positions": [
          1,
          2
        ],
        "lines": [
          "中仄/中平/平仄仄",
          "平中仄",
          "中平/中仄/仄平平",
          "仄平平"
        ]
      }
    },
    {
      "name": "贺铸",
      "source_id": 231,
      "length_category": "short",
      "variants_description": "此词后段第二句仍押平韵，每句添声俱用“仄平平”，宋词皆照此填，与唐词小异。按此体见《梅苑》及《乐府雅词》，皆作《杨柳枝》。\n又按贺词八首名《太平时》，多用前人绝句，添入和声，盖即《添声杨柳枝》也。《词律》以《太平时》另列一体者误。\n按欧阳修词前段第三句“垂杨漫舞绿丝绦”，“慢”字可仄，谱内据此，其余参校唐词。",
      "rhyme_type": "平韵",
      "number_of_stanzas": 2,
