{
  "name": "人月圆",
  "aliases": [],
  "description": "《中原音韵》注“黄钟宫”。此调始于王诜，因词中“人月圆时”句，取以为名。吴 激词有“青衫泪湿”句，又名《青衫湿》。",
  "default_variant": "王诜",
  "default_variant_source_id": 463,
  "variants": [
    {
      "name": "王诜",
      "source_id": 463,
      "length_category": "short",
      "variants_description": "此调以此词为正体，即《中原音韵》所注“黄钟宫”者。若杨词之摊破句法、或押仄韵者，皆变格也。\n前段第三、四句，倪瓒词“画屏云嶂，池塘春草”，“画”字仄声，“云”字、“春” 字俱平声。后段第一、二句，刘因词“门前报导，曲生来谒”，“门”字平声，“曲” 字仄声。第四句，赵鼎词“芳尊美酒”，“芳”字平声，“美”字仄声。第五句，张可久词“香炉峰下”，“峰”字平声。第六句，赵词“月满高楼”，“月”字仄声。谱内可平可仄据此，余参下词。",
      "rhyme_type": "平韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          2,
          5
        ],
        "lines": [
          "中平/中仄/平平仄",
          "中仄/仄平平",
          "中平/中仄",
          "平平/中仄",
          "中仄/平平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          3,
          6
        ],
        "lines": [
          "中平/中仄",
          "中平/中仄",
          "中仄/平平",
          "中平/中仄",
          "平平/中仄",
          "中仄/平平"
        ]
      }
    },
