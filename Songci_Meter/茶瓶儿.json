          "平/仄仄平平/平仄",
          "平仄/平平仄",
          "仄平/平仄",
          "平仄/平平仄"
        ]
      }
    },
    {
      "name": "赵彦端",
      "source_id": 816,
      "length_category": "short",
      "variants_description": "此词两起句照李词各减去一字，其第三、第四、第五句又破作两句，虽字数同，而句法已不同矣。",
      "rhyme_type": "仄韵",
