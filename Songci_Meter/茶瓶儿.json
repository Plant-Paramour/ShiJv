{
  "name": "茶瓶儿",
  "aliases": [],
  "description": "调见《花庵词选》。始自北宋李元膺，至南宋赵彦端、石孝友二家，又摊破两结句法， 减去两起句字，自成新声。",
  "default_variant": "李元膺",
  "default_variant_source_id": 815,
  "variants": [
    {
      "name": "李元膺",
      "source_id": 815,
      "length_category": "short",
      "variants_description": "此词无别首可校。后采赵、石二词，其源虽出于此，然句读不同，音律亦变，未可参校。旧谱混注平仄者误。\n《词律》以后结“絮”字非韵，不知前句不押韵后句押韵者词中尽多，若在换头后结更多。盖词以韵为拍，过变曲终，不妨多加拍也。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          3,
          5
        ],
        "lines": [
          "仄平/平平/平仄仄",
          "仄平仄、平平/平仄",
          "平仄/平平仄",
          "仄平/平仄",
          "仄仄/平平仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          1,
