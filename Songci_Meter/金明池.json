{
  "name": "金明池",
  "aliases": [],
  "description": "调见《淮海词》，赋东京金明池，即以调为题也。李弥逊词名《昆明池》，僧挥词名《夏云峰》。",
  "default_variant": "秦观",
  "default_variant_source_id": 2202,
