          3,
          4
        ],
        "lines": [
          "平平/平仄/仄平平",
          "平仄/平平仄",
          "平仄/平平/仄平仄",
          "仄平平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          1,
          2,
          3,
          4
        ],
        "lines": [
          "平平/仄仄/平平仄",
          "平平/仄仄",
          "平平/平仄",
          "平仄/仄平平"
        ]
      }
    },
    {
      "name": "王恽",
      "source_id": 267,
      "length_category": "short",
      "variants_description": "此词后段结句六字，王词别首“道别后、意如何”，正与此同，皆衬字也。若《太平乐府》无名氏词，后段第二、三、四句“问谁家有酒，见青帘高挂，高挂在杨柳杏花邨”，衬字太多，则曲而非词矣，故不采入。",
      "rhyme_type": "平仄转换韵",
