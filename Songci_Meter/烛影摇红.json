{
  "name": "烛影摇红",
  "aliases": [],
  "description": "宋吴曾《能改斋漫录》：王都尉诜有《忆故人》词，徽宗喜其词意，犹以不丰容宛转 为恨，乃令大晟乐府别撰腔，周邦彦增益其词，而以首句为名，谓之《烛影摇红》。",
  "default_variant": "毛滂",
  "default_variant_source_id": 451,
  "variants": [
    {
      "name": "毛滂",
      "source_id": 451,
      "length_category": "short",
      "variants_description": "周词前段即此词体也，故可平可仄即可参之，余校毛词别首及贺铸词。\n贺词前段第三句“离魂十里念佳期”，“十”字仄声。后段第二句“但衾枕余芳剩暖”，“枕”字仄声，毛词别首“唤人醒不教梦去”，“不”字仄声。第三、四、五句“他年寻我，水边月底，一蓑烟短”，“他”字、“边”字、“烟”字俱平声，“月”字、“底”字、“一”字俱仄声。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          2,
          4
        ],
        "lines": [
          "中仄/平平",
          "仄平/中仄/平平仄",
          "中平/中仄/仄平平",
          "中仄/平平仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          1,
          2,
          5
        ],
        "lines": [
          "中仄/中平/中仄",
          "仄中中、中平/仄仄",
