{
  "name": "清商怨",
  "aliases": [],
  "description": "古乐府有清商曲辞，其音多哀怨，故取以为名。周邦彦以晏词有“关河愁思”句， 更名《关河令》，又名《伤情怨》。",
  "default_variant": "晏殊",
  "default_variant_source_id": 298,
  "variants": [
    {
      "name": "晏殊",
      "source_id": 298,
      "length_category": "short",
      "variants_description": "此词前段起句七字，赵师侠词二首、周邦彦词一首皆同。\n按赵词前段起句“亭皋霜重飞叶满”，“飞”字平声。又“江头伊轧动柔橹”， “柔”字平声。第二句“听西风断雁”，“西”字平声。第三句“閒凭危阑”，“閒” 字平声。第四句“波间自容与”，“自”字仄声，“容”字平声。后段第一句“岸蓼汀苹无绪”，“岸”字、“蓼”字俱仄声，“无”字平声。第二句“误仿佛征帆几点”，“几”字仄声。晏几道词后段起句“回文锦字暗剪”，“锦”字仄声。方千里词第二句“度寒食禁烟须到”，“寒”字平声。谱内可平可仄据此，余参周、沈二词。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          4
        ],
        "lines": [
          "平平/平仄/中中仄",
          "仄中平/中仄",
          "中仄/平平",
          "中平/中中仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          1,
          2,
          4
        ],
        "lines": [
          "中中/中中/中仄",
          "仄中中、中中/中仄",
          "仄仄/平平",
          "平平/平仄仄"
        ]
      }
    },
    {
      "name": "周邦彦",
      "source_id": 299,
      "length_category": "short",
      "variants_description": "此词起作六字句，晏几道、方千里、杨泽民、陈允平词，皆与此同。但此调前段第二句五字，例须上一下四句法，晏、赵、方、杨，莫不皆然，惟陈允平词“篱菊都荒了” 小异，不可从。",
      "rhyme_type": "仄韵",
