          "平平/平仄仄"
        ]
      }
    },
    {
      "name": "沈会宗",
      "source_id": 300,
      "length_category": "short",
      "variants_description": "此与周词同，惟后段第二句八字异。“谁遣”，坊本作“谁遗”，今照《天机余锦》改正。或云“遣”字亦短韵。",
      "rhyme_type": "仄韵",
