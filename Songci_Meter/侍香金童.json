{
  "name": "侍香金童",
  "aliases": [],
  "description": "金词注“黄钟宫”，又“黄钟调”。按《开天遗事》，王元宝常于寝帐牀前，雕矮童二人，捧一宝博山炉，自暝焚香彻晓，调名取此。无名氏词即咏其事也。",
  "default_variant": "无名氏",
  "default_variant_source_id": 935,
  "variants": [
    {
      "name": "无名氏",
      "source_id": 935,
      "length_category": "medium",
      "variants_description": "此调有蔡伸、赵长卿二词可校。此词后段第三句八字，蔡伸词则前段第三句八字，赵长卿词则前后段第三句皆八字，余俱同。可平可仄即参二词。\n按金词注“黄钟宫”者，本此填，惟换头仍作四字一句、五字一句。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
