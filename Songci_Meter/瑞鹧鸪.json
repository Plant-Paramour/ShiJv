          "仄平/仄仄/仄平平",
          "仄平/仄仄/平平仄",
          "平仄/平平/平仄平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          4
        ],
        "lines": [
          "仄仄/平平/平仄仄",
