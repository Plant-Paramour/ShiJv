{
  "name": "凤衔杯",
  "aliases": [],
  "description": "此调有平韵、仄韵两体。仄韵者，《乐章集》注“大石调”。",
  "default_variant": "晏殊",
  "default_variant_source_id": 800,
  "variants": [
    {
      "name": "晏殊",
      "source_id": 800,
      "length_category": "short",
      "variants_description": "此词前段第三句、后段第四句俱九字蝉联不断，即平韵体亦然，填者亦遵之。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          3,
          4
        ],
        "lines": [
          "平平/仄仄/平平仄",
          "平仄仄、仄平/平仄",
          "仄仄/平平、平仄/平平仄",
          "平仄仄、平平仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          3,
          4,
          5
        ],
        "lines": [
          "仄平平",
          "仄平仄",
          "平仄仄、仄平/平仄",
          "仄仄/平平/仄仄、平平仄",
          "仄仄/平平仄"
        ]
      }
    },
    {
      "name": "柳永",
      "source_id": 801,
      "length_category": "medium",
      "variants_description": "此与仄韵晏词同，惟前段第三句、后段第四句各添三字，两结句俱六字异。\n柳词别首前段起句“有美瑶卿能染翰”，“有”字、“染”字俱仄声。三四句“想初擘苕笺，旋挥翠管红窗畔”，“初”字平声，“翠”字仄声。换头句“锦囊收，犀轴卷”，“犀”字平声，“轴”字仄声。第四句“更宝若珠玑”，“宝”字仄声。结句“似顿见、千娇面”，“顿”字仄声。谱内可平可仄据此，余参仄韵晏词。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          4,
          5
        ],
        "lines": [
          "中仄/平平/平中仄",
          "平中仄、仄平/平仄",
          "仄/中仄/平平",
          "仄平/中仄/平平仄",
          "中仄仄、平平仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          1,
          2,
          4,
          5
        ],
        "lines": [
          "仄平平、中中仄",
          "平中中、仄平/平仄",
          "仄/中仄/平平",
          "仄平/平仄/平平仄",
          "仄中仄、平平仄"
        ]
      }
    },
    {
      "name": "晏殊",
      "source_id": 802,
      "length_category": "short",
      "variants_description": "此与仄韵词同，起句“颣”字，《广韵》注“麤丝也”。或作“类”字者误。",
      "rhyme_type": "平韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          3,
          4
        ],
        "lines": [
          "仄平/平仄/仄平平",
          "仄仄平、平仄/平平",
          "仄仄/仄平/平仄、仄平平",
          "平仄仄、仄平平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          3,
          4,
          5
        ],
        "lines": [
          "平/仄仄",
          "仄/平平",
          "仄平平、平仄/平平",
          "平仄/仄平平仄、仄平平",
          "仄仄/仄平平"
        ]
      }
    },
    {
      "name": "杜安世",
      "source_id": 803,
      "length_category": "short",
      "variants_description": "晏殊《珠玉集》亦载此词，后段结句少一字，今从《寿域词》本。按杜词别首前后两结俱六字，原自相同也。\n杜词别首前段第三句“凄惨断云片雨、各江天”，“凄”字平声，“片”字仄声。后段第三句“想至今、谁为相怜”，“至”字仄声。第四句“多少旧欢往事、一澘然”， “往”字仄声。结句“空牵惹、病缠绵”，“牵”字平声。谱内可平可仄据此，余参平韵晏词。",
      "rhyme_type": "平韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          3,
          4
        ],
        "lines": [
          "中平/中仄/仄平平",
          "仄中平、平仄/平平",
          "中仄/中平/中仄、仄平平",
          "平仄仄、仄平平"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          3,
          4,
          5
        ],
        "lines": [
          "平中仄",
          "仄平平",
          "仄中平、平仄/平平",
          "平仄/仄平/中仄、仄平平",
          "平中仄、仄平平"
        ]
      }
    }
  ]
}
