{
  "name": "雨中花令",
  "aliases": [],
  "description": "王观词名《送将归》。按《雨中花》调与《夜行船》调最易相混，宋人集中每多误刻。今照《花草粹编》所编，以两结句五字者为《雨中花》。两结句六字、七字者为《夜行船》。",
  "default_variant": "晏殊",
  "default_variant_source_id": 609,
  "variants": [
    {
      "name": "晏殊",
      "source_id": 609,
      "length_category": "short",
      "variants_description": "此调始于此词，宋人照此填者，或于前段起句添一字，或于前段第二句添一字，或于后段第二句减一字，或于前后段第三句添一字摊破句法一句作两句，其源皆出于此。惟周紫芝词则又裁截慢词，与此不同。故谱内但以两段起结句法同者，参校平仄。\n按此体前后段第三句例各七字，此词后段多一“许”字，乃衬字也，与下欧词“且” 字同。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          4
        ],
        "lines": [
          "中仄/中平/中仄",
          "中中/中平/中仄",
          "中仄/平平/平仄仄",
          "中仄/平平仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          1,
          2,
          4
        ],
        "lines": [
          "中仄/中平/平仄仄",
          "仄中仄、仄平/平仄",
          "仄仄仄、仄平/平仄仄",
          "中仄/平平仄"
        ]
      }
    },
