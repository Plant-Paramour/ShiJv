{
  "name": "倾杯乐",
  "aliases": [],
  "description": "唐教坊曲名。《乐府杂录》云：“《倾杯乐》，宣宗喜吹芦管，自制此曲。”见《宋史·乐志》者二十七宫调，柳永《乐章集》注“宫调七”。一名《古倾杯》，亦名《倾杯》。",
  "default_variant": "柳永",
  "default_variant_source_id": 1971,
