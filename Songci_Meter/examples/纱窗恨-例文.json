{
  "name": "纱窗恨",
  "variants": [
    {
      "name": "毛文锡",
      "source_id": 257,
      "stanza1": {
        "lines": [
          "新春/燕子/还来至",
          "一双飞",
          "垒巢/泥湿/时时坠",
          "涴人衣"
        ]
      },
      "stanza2": {
        "lines": [
          "后园里、看/百花发",
          "香风拂、绣户/金扉",
          "月照/纱窗",
          "恨依依"
        ]
      }
    },
    {
      "name": "毛文锡",
      "source_id": 258,
      "stanza1": {
        "lines": [
          "双双/蝶翅/涂铅粉",
          "咂花心",
          "绮窗/绣户/飞来稳",
          "画堂阴"
        ]
      },
      "stanza2": {
        "lines": [
          "二三月、爱/随风絮",
          "伴落花、来拂/衣襟",
          "更剪/轻罗片",
          "傅黄金"
        ]
      }
    }
  ]
}