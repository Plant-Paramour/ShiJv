{
  "name": "无闷",
  "variants": [
    {
      "name": "程垓",
      "source_id": 1641,
      "stanza1": {
        "lines": [
          "天与/多才",
          "不合/更与",
          "殢柳/怜花/情分",
          "甚总为/才情",
          "恼人/方寸",
          "早是/春残/花褪",
          "也不料、一春/都成病",
          "自失笑、因甚/腰围/半减",
          "泪珠/频搵"
        ]
      },
      "stanza2": {
        "lines": [
          "难省",
          "也怨天",
          "也自恨",
          "怎免/千般/思忖",
          "倩人/说与",
          "又却/不忍",
          "拌了/一生/愁闷",
          "又只恐、愁多/无人问",
          "到这里、天也/怜人",
          "看他/稳也/不稳"
        ]
      }
    }
  ]
}