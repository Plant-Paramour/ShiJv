{
  "name": "有有令",
  "variants": [
    {
      "name": "赵长卿",
      "source_id": 1202,
      "stanza1": {
        "lines": [
          "前山/减翠",
          "疏竹/度轻风",
          "日移/金影碎",
          "还又/年华暮",
          "看看是、新春至",
          "那更堪、有箇/人人",
          "似花/似玉",
          "温柔/伶俐"
        ]
      },
      "stanza2": {
        "lines": [
          "准拟",
          "恩情/海似",
          "拈弄上、则人/难比",
          "我也/诚心/一片",
          "你也/爭些气",
          "大家/到底/如此",
          "美中/更美",
          "厮守定、共伊/百岁"
        ]
      }
    }
  ]
}