{
  "name": "小重山",
  "variants": [
    {
      "name": "薛昭蕴",
      "source_id": 841,
      "stanza1": {
        "lines": [
          "春到/长门/春草青",
          "玉阶/华露滴、月胧明",
          "东风/吹断/玉箫声",
          "宫漏促、帘外/晓啼莺"
        ]
      },
      "stanza2": {
        "lines": [
          "愁起/梦难成",
          "红妆/流宿泪、不胜情",
          "手挼/裙带/绕花行",
          "思君切、罗幌/暗尘生"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 842,
      "stanza1": {
        "lines": [
          "一夜/中庭/拂翠条",
          "碧纱/窗外雨、长凉飙",
          "潮来/涨水/恰平桥",
          "添清景",
          "疏韵响、入芭蕉"
        ]
      },
      "stanza2": {
        "lines": [
          "坐久/篆香消",
          "多情/人去后、信音遥",
          "即今/消瘦/沈郎腰",
          "悲秋切",
          "虚过了、可怜宵"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 843,
      "stanza1": {
        "lines": [
          "不是/蛾儿/不是酥",
          "化工/应道/也难摹",
          "花儿/清瘦/影儿孤",
          "多情处、时有/暗香浮"
        ]
      },
      "stanza2": {
        "lines": [
          "试问/玉肌肤",
          "夜来/霜雪重、怕寒无",
          "一枝/欲寄/洞庭姝",
          "可惜许、祇有/雁衔芦"
        ]
      }
    },
    {
      "name": "黄子行",
      "source_id": 844,
      "stanza1": {
        "lines": [
          "一点/斜阳/红欲滴",
          "白鸥/飞不尽、楚天碧",
          "渔歌/声断/晚风急",
          "揽芦花、飞雪/满林湿"
        ]
      },
      "stanza2": {
        "lines": [
          "孤馆/百忧集",
          "家山/千里远、梦难觅",
          "江湖/风月/好收拾",
          "故溪云、深处/著蓑笠"
        ]
      }
    }
  ]
}