          "恼得/人越醉"
        ]
      }
    },
    {
      "name": "欧良",
      "source_id": 671,
      "stanza1": {
        "lines": [
          "河可挽",
          "石可转",
          "那一箇/愁字",
          "却难/驱遣",
          "眉/向酒边/暂展",
          "酒后/依旧见"
        ]
      },
      "stanza2": {
        "lines": [
          "枫叶/满阶/红万片",
          "待拾来、一一/题写/教遍",
