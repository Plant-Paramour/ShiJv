{
  "name": "步蟾宫",
  "variants": [
    {
      "name": "黄庭坚",
      "source_id": 855,
      "stanza1": {
        "lines": [
          "虫儿/真箇/恶灵利",
          "恼乱得、道人/眠起",
          "醉归来、恰似/出桃源",
          "但目断、落花/流水"
        ]
      },
      "stanza2": {
        "lines": [
          "不如/随我/归云际",
          "共作箇、住山/活计",
          "照清溪",
          "匀粉面",
          "插山花",
          "算终胜、风尘/滋味"
        ]
      }
    },
    {
      "name": "杨无咎",
      "source_id": 856,
      "stanza1": {
        "lines": [
          "桂花/馥郁/清无寐",
          "觉身在、广寒/宫里",
          "忆吾家、妃子/旧游时",
          "瑞龙脑、暗藏/叶底"
        ]
      },
      "stanza2": {
        "lines": [
          "不堪/午夜/西风起",
          "更飐飐、万丝/斜坠",
          "向晚来、却似/给孤园",
          "乍惊见、黄金/布地"
        ]
      }
    },
    {
      "name": "蒋捷",
      "source_id": 857,
      "stanza1": {
        "lines": [
          "玉窗/掣锁/香云涨",
          "唤绿袖、低敲/方响",
          "流苏/拂处/字微讹",
          "但斜倚、红梅/一晌"
        ]
      },
      "stanza2": {
        "lines": [
          "濛濛月/在帘衣上",
          "做池馆、春阴/模样",
          "春阴/模样/不如春",
          "这催雪、曲儿/休唱"
        ]
      }
    },
    {
      "name": "汪存",
      "source_id": 858,
      "stanza1": {
        "lines": [
          "玉京/此去/春犹浅",
          "正雪絮、马头/零乱",
          "姮娥/剪就/绿云裳",
          "待来步、蟾宫/与换"
        ]
      },
      "stanza2": {
        "lines": [
          "明年/二月/桃花岸",
          "棹双桨、浪平/烟暖",
          "扬州/十里/小红楼",
          "尽卷上、珠帘/一半"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 859,
      "stanza1": {
        "lines": [
          "未开/大如/木犀蕊",
          "开后是、梅花小底",
          "翛然/只欲/住山林",
          "肯容易、结根/城市"
        ]
      },
      "stanza2": {
        "lines": [
          "叶儿/又与/冬青比",
          "算何止、香闻/七里",
          "不因/山谷/品题来",
          "谁知道、是水仙/兄弟"
        ]
      }
    }
  ]
}