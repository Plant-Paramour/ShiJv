{
  "name": "枕屏儿",
  "variants": [
    {
      "name": "无名氏",
      "source_id": 1085,
      "stanza1": {
        "lines": [
          "江国/春来",
          "留得/素英/肯住",
          "月笼香",
          "风弄粉",
          "诗人/尽许",
          "酥蕊嫩",
          "檀心小",
          "不禁/风雨",
          "须东君、与他/做主"
        ]
      },
      "stanza2": {
        "lines": [
          "繁杏/夭桃",
          "颜色/浅深/难驻",
          "奈芳容",
          "全不称",
          "冰姿/伴侣",
          "水亭边",
          "山驿畔",
          "一枝/风措",
          "十分似、那人/淡泞"
        ]
      }
    }
  ]
