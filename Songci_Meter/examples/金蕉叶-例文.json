{
  "name": "金蕉叶",
  "variants": [
    {
      "name": "柳永",
      "source_id": 914,
      "stanza1": {
        "lines": [
          "厌厌/夜饮/平阳第",
          "添银烛、旋呼/佳丽",
          "巧笑/难禁",
          "艳歌/无间/声相继",
          "准拟/幕天/席地"
        ]
      },
      "stanza2": {
        "lines": [
          "金蕉/叶泛/金波霁",
          "未更阑、已尽/狂醉",
          "就中/有箇",
          "风流/暗向/灯光底",
          "恼遍/两行/珠翠"
        ]
      }
    },
    {
      "name": "袁去华",
      "source_id": 915,
      "stanza1": {
        "lines": [
          "江枫/半赤",
          "雨初晴、雁空/绀碧",
          "爱篱落、黄花/秀色",
          "带零露/旋摘"
        ]
      },
      "stanza2": {
        "lines": [
          "向晚/西风/淡日",
          "发萧萧、任从/帽侧",
          "更莫把、茱萸/叹息",
          "且更持/大白"
        ]
      }
    },
    {
      "name": "袁去华",
      "source_id": 916,
      "stanza1": {
        "lines": [
          "行思/坐忆",
          "知他是、怎生/过日",
          "烦恼/无千/万亿",
          "诮将/做饭/吃"
        ]
      },
      "stanza2": {
        "lines": [
          "旧日/轻怜/痛惜",
          "却如今、怨深/恨极",
          "不觉/长吁/叹息",
          "便直恁/下得"
        ]
      }
    },
    {
      "name": "蒋捷",
      "source_id": 917,
      "stanza1": {
        "lines": [
          "云褰/翠幕",
          "满天星、碎珠/迸索",
          "孤蟾/阑外/照我",
          "看看/过转角"
        ]
      },
      "stanza2": {
        "lines": [
          "酒醒/寒砧/正作",
          "待眠来、梦魂/怕恶",
          "枕屏/那更/画了",
          "平沙/断雁落"
        ]
      }
    }
  ]
}