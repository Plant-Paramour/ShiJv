{
  "name": "武陵春",
  "variants": [
    {
      "name": "毛滂",
      "source_id": 471,
      "stanza1": {
        "lines": [
          "风过/冰檐/环佩响",
          "宿雾/在华茵",
          "剩落/瑶花/衬月明",
          "嫌怕/有纤尘"
        ]
      },
      "stanza2": {
        "lines": [
          "凤口/衔灯/金炫转",
          "人醉/觉寒轻",
          "但得/清光/解照人",
          "不负/五更春"
        ]
      }
    },
    {
      "name": "李清照",
      "source_id": 472,
      "stanza1": {
        "lines": [
          "风住/尘香/春已尽",
          "日晚/倦梳头",
          "物是/人非/事事休",
          "欲语/泪先流"
        ]
      },
      "stanza2": {
        "lines": [
          "闻说/双溪/春尚好",
          "也拟/泛轻舟",
          "只恐/双溪/舴艋舟",
          "载不动、许多愁"
        ]
      }
    },
    {
      "name": "万俟咏",
      "source_id": 473,
      "stanza1": {
        "lines": [
          "燕子/飞来/春在否",
          "微雨过、掩重门",
          "正/满院/梨花/雪照人",
          "独自箇、忆黄昏"
        ]
      },
      "stanza2": {
        "lines": [
          "清风/淡月/总销魂",
          "罗衣暗、惹啼痕",
          "漫觑著/秋千/腰褪裙",
          "可煞是、不宜春"
        ]
      }
    }
  ]
}