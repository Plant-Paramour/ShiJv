{
  "name": "茶瓶儿",
  "variants": [
    {
      "name": "李元膺",
      "source_id": 815,
      "stanza1": {
        "lines": [
          "去年/相逢/深院宇",
          "海棠下、曾歌/金缕",
          "歌罢/花如雨",
          "翠罗/衫上",
          "点点/红无数"
        ]
      },
      "stanza2": {
        "lines": [
          "今岁/重寻/携手处",
          "空/物是人非/春暮",
          "回首/青云路",
          "乱英/飞絮",
          "相逐/东风去"
        ]
      }
    },
    {
      "name": "赵彦端",
      "source_id": 816,
      "stanza1": {
        "lines": [
          "淡月/华灯/春夜",
          "送东风、柳烟/梅麝",
          "宝钗/宫髻/连娇马",
          "似记得、帝乡/游冶"
        ]
      },
      "stanza2": {
        "lines": [
          "悦亲戚/之情话",
          "况溪山、坐中/如画",
          "凌波/微步/人归也",
          "看酒醒、凤鸾/谁跨"
        ]
      }
    },
    {
      "name": "石孝友",
      "source_id": 817,
      "stanza1": {
        "lines": [
          "相对/盈盈/一水",
          "多声价、问名/得字",
          "刚能/见也/还抛弃",
          "孤负了、万红/千翠"
        ]
      },
      "stanza2": {
        "lines": [
          "留无计",
          "来无计",
          "闷厌厌、几何况味",
          "而今/若没/些儿事",
          "却枉了、做人一世"
        ]
      },
