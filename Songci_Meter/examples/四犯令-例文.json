{
  "name": "四犯令",
  "variants": [
    {
      "name": "侯寘",
      "source_id": 579,
      "stanza1": {
        "lines": [
          "月破/轻云/天淡注",
          "夜悄/花无语",
          "莫听/阳关/牵离绪",
          "拌酩酊、花深处"
        ]
      },
      "stanza2": {
        "lines": [
          "明日/江郊/芳草路",
          "春逐/行人去",
          "不是/酴醾/开独步",
          "能著意、留春住"
        ]
      }
    }
  ]
}
