{
  "name": "踏歌",
  "variants": [
    {
      "name": "朱敦儒",
      "source_id": 1290,
      "stanza1": {
        "lines": [
          "宴阕",
          "散津亭、鼓吹/扁舟发",
          "离愁黯、隐隐/阳关彻",
          "更风愁/雨细/添凄切"
        ]
      },
      "stanza2": {
        "lines": [
          "恨结",
          "叹良朋、雅聚/轻离缺",
          "一年几、把酒/对花月",
          "便山遥/水远/分吴越"
        ]
      },
      "stanza3": {
        "lines": [
          "书倩燕",
          "梦借蝶",
          "重相见、再把/归期说",
          "只愁/到他时",
          "彼此/萍踪别",
          "总难如/再会时节"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 1291,
      "stanza1": {
        "lines": [
          "带雪",
          "向南/枝一朵/江梅坼",
          "许多时、甚处/收香白",
          "占千葩/百卉/先春色"
        ]
      },
      "stanza2": {
        "lines": [
          "莹洁",
          "正广寒/宫殿/人窥隔",
          "销魂更、画角/声声/彻",
          "賸/暗香/浮动/黄昏月"
        ]
      },
      "stanza3": {
        "lines": [
          "最潇洒/处最奇绝",
          "孤标迥、不与/群芳列",
          "吟赏/竟连宵",
          "痛饮/无休歇",
          "输有心/牧童偷折"
        ]
      }
    }
  ]
}