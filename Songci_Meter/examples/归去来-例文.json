{
  "name": "归去来",
  "variants": [
    {
      "name": "柳永",
      "source_id": 491,
      "stanza1": {
        "lines": [
          "初过/元宵/三五",
          "慵困/春/情绪",
          "灯月/阑珊/嬉游处",
          "游人尽、厌欢聚"
        ]
      },
      "stanza2": {
        "lines": [
          "凭仗/如花女",
          "持杯谢、酒朋/诗侣",
          "余酲/更不/禁香醑",
          "歌筵舞、且归去"
        ]
      }
    },
    {
      "name": "柳永",
      "source_id": 492,
      "stanza1": {
        "lines": [
          "一夜/狂风雨",
          "花阴坠、碎红/无数",
          "垂杨/漫结/黄金缕",
          "尽春残、萦不住"
        ]
      },
      "stanza2": {
        "lines": [
          "蝶稀/蜂散/知何处",
          "殢尊酒、转添/愁绪",
          "多情/不惯/相思苦",
          "休惆怅、好归去"
        ]
      }
    }
  ]
}