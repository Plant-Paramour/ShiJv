      "stanza1": {
        "lines": [
          "梅梢/弄粉/香犹嫩",
          "欲寄/江南/春信",
          "别后/愁肠/萦损",
          "说与/伊爭稳"
        ]
      },
      "stanza2": {
        "lines": [
          "小炉/独守/寒灰烬",
          "忍泪/低头/画尽",
          "眉上/万重/新恨",
          "竟日/无人问"
        ]
      }
    },
    {
      "name": "王庭珪",
      "source_id": 446,
      "stanza1": {
        "lines": [
          "催花/一霎/清明雨",
          "留得/东风/且住",
          "两岸/柳汀/烟坞",
          "未放/行人去"
        ]
      },
      "stanza2": {
        "lines": [
          "人如/双鹄/云间举",
          "明月夜、扁舟/何处",
          "只向/武陵/南渡",
          "便是/长安路"
        ]
      }
    }
  ]
