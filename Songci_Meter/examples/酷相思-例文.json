  "name": "酷相思",
  "variants": [
    {
      "name": "程垓",
      "source_id": 960,
      "stanza1": {
        "lines": [
          "月挂/霜林/寒欲坠",
          "正门外、催人起",
          "奈离别、如今/真箇是",
          "欲住也、留无计",
          "欲去也、来无计"
        ]
      },
      "stanza2": {
        "lines": [
          "马上/离情/衣上泪",
          "各自箇、供憔悴",
          "问江路、梅花/开也未",
          "春到也、须频寄",
          "人到也、须频寄"
        ]
      },
