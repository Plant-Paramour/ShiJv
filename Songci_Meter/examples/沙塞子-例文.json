{
  "name": "沙塞子",
  "variants": [
    {
      "name": "朱敦儒",
      "source_id": 281,
      "stanza1": {
        "lines": [
          "万里/飘零/南越",
          "山引泪",
          "酒催愁",
          "不见/凤楼/龙阙",
          "又经秋"
        ]
      },
      "stanza2": {
        "lines": [
          "九日/江亭/閒望",
          "蛮树远",
          "瘴烟浮",
          "肠断/红蕉/花晚",
          "水西流"
        ]
      }
    },
    {
      "name": "葛立方",
      "source_id": 282,
      "stanza1": {
        "lines": [
          "天生/玉骨/冰肌",
          "瘦损也、知他/为谁",
          "寒涧底、傲霜/凌雪",
          "不教/春知"
        ]
      },
      "stanza2": {
        "lines": [
          "高楼/横笛/试轻吹",
          "要一片、花飞/酒卮",
          "拼沈醉、帽檐/斜插",
          "折取/南枝"
        ]
      }
    },
    {
      "name": "周紫芝",
      "source_id": 283,
      "stanza1": {
        "lines": [
          "玉溪/秋月/浸寒波",
          "忍持酒、重听/骊歌",
          "不堪对、绿阴/飞阁",
          "月下/羞蛾"
        ]
      },
      "stanza2": {
        "lines": [
          "夜深/惊鹊/转南柯",
          "惨别意、无奈/愁何",
          "他年事、不须/重问",
          "转更/愁多"
        ]
      }
    },
    {
      "name": "赵彦端",
      "source_id": 284,
      "stanza1": {
        "lines": [
          "春水/绿波/南浦",
          "渐理棹、行人/欲去",
          "黯消魂、柳际/轻烟",
          "花梢/微雨"
        ]
      },
      "stanza2": {
        "lines": [
          "长亭/放琖/无计住",
          "但芳草、迷人/去路",
          "忍回头、断云/残日",
          "长安/何处"
        ]
      }
    }
  ]
}