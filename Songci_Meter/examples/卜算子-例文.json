{
  "name": "卜算子",
  "variants": [
    {
      "name": "苏轼",
      "source_id": 316,
      "stanza1": {
        "lines": [
          "缺月/挂疏桐",
          "漏断/人初静",
          "时见/幽人/独往来",
          "缥缈/孤鸿影"
        ]
      },
      "stanza2": {
        "lines": [
          "惊起/却回头",
          "有恨/无人省",
          "拣尽/寒枝/不肯栖",
          "寂寞/沙洲冷"
        ]
      }
    },
    {
      "name": "石孝友",
      "source_id": 317,
      "stanza1": {
        "lines": [
          "见也/如何暮",
          "别也/如何遽",
          "别也/应难/见也难",
          "后会/难凭据"
        ]
      },
      "stanza2": {
        "lines": [
          "去也/如何去",
          "住也/如何住",
          "住也/应难/去也难",
          "此际/难分付"
        ]
      }
    },
    {
      "name": "徐俯",
      "source_id": 318,
      "stanza1": {
        "lines": [
          "胸中/千种愁",
          "挂在/斜阳树",
          "绿叶/阴阴/自得春",
          "草满/莺啼处"
        ]
      },
      "stanza2": {
        "lines": [
          "不见/凌波步",
          "空想/如簧语",
          "门外/重重/叠叠山",
          "遮不断、愁来路"
        ]
      }
    },
    {
      "name": "黄公度",
      "source_id": 319,
      "stanza1": {
        "lines": [
          "薄宦/各东西",
          "往事/随风雨",
          "先是/骊歌/不忍闻",
          "又何况、春将暮"
        ]
      },
      "stanza2": {
        "lines": [
          "愁共/落花多",
          "人逐/征鸿去",
          "君向/潇湘/我向秦",
          "后会/知何处"
        ]
      }
    },
    {
      "name": "张先",
      "source_id": 320,
      "stanza1": {
        "lines": [
          "梦短/寒夜长",
          "坐待/清霜晓",
          "临镜/无人/为整妆",
          "但自学、孤鸾照"
        ]
      },
      "stanza2": {
        "lines": [
          "楼台/红树杪",
          "风月/依前好",
          "江水/东流/郎在西",
          "问尺素、何由到"
        ]
      }
    },
    {
      "name": "杜安世",
      "source_id": 321,
      "stanza1": {
        "lines": [
          "深院/花铺地",
          "淡淡/阴天气",
          "水榭/风亭/朱明景",
          "又别是、愁情味"
        ]
      },
      "stanza2": {
        "lines": [
          "有情/奈无计",
          "漫惹/成憔悴",
          "欲把/罗巾/暗传寄",
          "细认取、斑点泪"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 322,
      "stanza1": {
        "lines": [
          "幽花/带露红",
          "湿柳/拖烟翠",
          "花柳/分春/各自芳",
          "惟有/人憔悴"
        ]
      },
      "stanza2": {
        "lines": [
          "寄与/手中书",
          "问肯/归来未",
          "正是/东风/料峭寒",
          "如何/独自/教人睡"
        ]
      }
    }
  ]
}