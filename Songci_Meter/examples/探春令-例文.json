{
  "name": "探春令",
  "variants": [
    {
      "name": "宋徽宗",
      "source_id": 590,
      "stanza1": {
        "lines": [
          "帘旌/微动",
          "峭寒/天气",
          "龙池/冰泮",
          "杏花/笑吐/香红浅",
          "又还是、春将半"
        ]
      },
      "stanza2": {
        "lines": [
          "清歌/妙舞/从头按",
          "等/芳时/开宴",
          "记/去年、对著/东风",
          "曾许/不负/莺花愿"
        ]
      }
    },
    {
      "name": "杨无咎",
      "source_id": 591,
      "stanza1": {
        "lines": [
          "雪梅/风柳",
          "弄金鈎粉",
          "峭寒/犹浅",
          "又还近、三五/银蟾满",
          "渐玉漏、声初短"
        ]
      },
      "stanza2": {
        "lines": [
          "尊前/重约/年时伴",
          "拣灯词/先按",
          "便直饶、心似/蛾儿/撩乱",
          "也有/春风管"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 592,
      "stanza1": {
        "lines": [
          "数声/回雁",
          "几番/疏雨",
          "东风/回暖",
          "甚今年、立得/春来晚",
          "过人日、方相见"
        ]
      },
      "stanza2": {
        "lines": [
          "缕金/幡胜/教先办",
          "著工夫/裁剪",
          "到那时/赌当",
          "须教/滴惜",
          "称得/梅妆面"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 593,
      "stanza1": {
        "lines": [
          "溪桥/山路",
          "竹篱/茆舍",
          "凄凉/风雨",
          "被/摧残/沮挫",
          "精神/依旧",
          "无奈/相思苦"
        ]
      },
      "stanza2": {
        "lines": [
          "东风/故与/收拾取",
          "忍教他/尘土",
          "向/绿窗/绣户",
          "朱阑/小槛",
          "做箇/名花主"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 594,
      "stanza1": {
        "lines": [
          "而今/风韵",
          "旧时/标致",
          "总皆/奇绝",
          "再相逢、还是/春前/腊后",
          "粉面/凝香雪"
        ]
      },
      "stanza2": {
        "lines": [
          "芳心/自与/群花别",
          "尽/孤高/清洁",
          "那情怀、最是/与人/好处",
          "冷淡/黄昏月"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 595,
      "stanza1": {
        "lines": [
          "清江/平淡",
          "暗香/潇洒",
          "满林/风露",
          "渐枝上、也学/杨花/飞絮",
          "轻逐/春归去"
        ]
      },
      "stanza2": {
        "lines": [
          "东君/著意/劝遮护",
          "总留/他不住",
          "幸西园、别有/能言/花貌",
          "委曲/关心愫"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 596,
      "stanza1": {
        "lines": [
          "冰澌/池面",
          "柳摇/金线",
          "春光/无限",
          "问/梅花/底事、收香/藏蕊",
          "到此/方舒展"
        ]
      },
      "stanza2": {
        "lines": [
          "百花/头上/俱休管",
          "且惊/开俗眼",
          "看/绿阴/结子",
          "成功/调鼎",
          "有甚/迟和晚"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 597,
      "stanza1": {
        "lines": [
          "冰檐/垂箸",
          "雪花/飞絮",
          "时方/严肃",
          "向/寻常/摇曳",
          "凡花/野草",
          "怎生敢、夸红绿"
        ]
      },
      "stanza2": {
        "lines": [
          "江梅/孤洁/无拘束",
          "只/温然/如玉",
          "自/一般/天赋",
          "风流/清秀",
          "总/不同/粗俗"
        ]
      }
    },
    {
      "name": "杨无咎",
      "source_id": 598,
      "stanza1": {
        "lines": [
          "梅英/粉淡",
          "柳梢/金软",
          "兰芽/依旧",
          "见万家、灯火/明如昼",
          "正人月、圆时候"
        ]
      },
      "stanza2": {
        "lines": [
          "挨香/傍玉/偷携手",
          "尽/轻衫/寒透",
          "听一声、画角/催残漏",
          "惜归去、频回首"
        ]
      }
    },
    {
      "name": "晏几道",
      "source_id": 599,
      "stanza1": {
        "lines": [
          "绿杨/枝上/晓莺啼",
          "报/融和/天气",
          "被数声、吹入/纱窗里",
          "又惊起、娇娥睡"
        ]
      },
      "stanza2": {
        "lines": [
          "绿云/斜亸/金钗坠",
          "惹/芳心/如醉",
          "为/少年、湿了/鲛绡帕",
          "上都是、相思泪"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 600,
      "stanza1": {
        "lines": [
          "草堂/三鼓/梦游仙",
          "到/蓬莱/阆苑",
          "正白云、满地/无人扫",
          "信幽圃、香风旋"
        ]
      },
      "stanza2": {
        "lines": [
          "群真/朝列/黄金殿",
          "醉流霞/琼宴",
          "顿觉来、一片/清凉意",
          "似明月、山头见"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 601,
      "stanza1": {
        "lines": [
          "去年/元夜/正钱塘",
          "看天街/灯火",
          "闹娥儿/转处",
          "熙熙/笑语",
          "百万/红妆女"
        ]
      },
      "stanza2": {
        "lines": [
          "今年/肯把/轻辜负",
          "列/荧煌/千炬",
          "趁/閒身/未老",
          "良辰/美景",
          "款醉/新歌舞"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 602,
      "stanza1": {
        "lines": [
          "笙歌/间错/华筵启",
          "喜/新春/新岁",
          "菜传/纤手",
          "青丝/轻细",
          "和气入、东风里"
        ]
      },
      "stanza2": {
        "lines": [
          "幡儿/胜儿/都姑媂",
          "戴得/更忔戏",
          "愿/新春/已后",
          "吉吉/利利",
          "百事/都如意"
        ]
      }
    }
  ]
}