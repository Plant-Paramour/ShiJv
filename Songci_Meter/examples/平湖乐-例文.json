{
  "name": "平湖乐",
  "variants": [
    {
      "name": "王恽",
      "source_id": 265,
      "stanza1": {
        "lines": [
          "安仁/双鬓/已惊秋",
          "更甚/眉头皱",
          "一笑/相逢/且开口",
          "玉为舟"
        ]
      },
      "stanza2": {
        "lines": [
          "新词/淡似/鹅黄酒",
          "醉扶/归路",
          "竹西/歌吹",
          "人道是/扬州"
        ]
      }
    },
    {
      "name": "张可久",
      "source_id": 266,
      "stanza1": {
        "lines": [
          "飞梅/和雪/洒林梢",
          "花落/春颠倒",
          "驴背/敲诗/暮寒峭",
          "路迢迢"
        ]
      },
      "stanza2": {
        "lines": [
          "相逢/不满/疏翁笑",
          "寒郊/瘦岛",
          "尘衣/风帽",
          "诗在/灞陵桥"
        ]
      }
    },
    {
      "name": "王恽",
      "source_id": 267,
      "stanza1": {
        "lines": [
          "采莲/人语/隔秋烟",
          "波静/如横练",
          "入手/风光/莫流转",
          "共留连"
        ]
      },
      "stanza2": {
        "lines": [
          "画船/一笑/春风面",
          "江山/信美",
          "终非/吾土",
          "问/何日、是归年"
        ]
      }
    }
  ]
}
