{
  "name": "燕归梁",
  "variants": [
    {
      "name": "晏殊",
      "source_id": 605,
      "stanza1": {
        "lines": [
          "双燕/归飞/绕画堂",
          "似/留恋/虹梁",
          "清风/明月/好时光",
          "更何况、绮筵张"
        ]
      },
      "stanza2": {
        "lines": [
          "云衫/侍女",
          "频倾/桂醑",
          "加意/动笙簧",
          "人人/心在/玉炉香",
          "逢佳会、祝延长"
        ]
      }
    },
    {
      "name": "史达祖",
      "source_id": 606,
      "stanza1": {
        "lines": [
          "独卧/秋窗/桂未香",
          "怕雨点/飘凉",
          "玉人/只在/楚云傍",
          "也著泪、过昏黄"
        ]
      },
      "stanza2": {
        "lines": [
          "西风/今夜/梧桐冷",
          "断无梦、到鸳鸯",
          "秋钲/二十五声长",
          "请各自、耐思量"
        ]
      }
    },
    {
      "name": "柳永",
      "source_id": 607,
      "stanza1": {
        "lines": [
          "织锦/裁篇/写意深",
          "字值/千金",
          "一回/披翫/一愁吟",
          "肠成结、泪盈襟"
        ]
      },
      "stanza2": {
        "lines": [
          "幽欢/已散/前期远",
          "无聊赖、是而今",
          "密凭/归雁/寄芳音",
          "恐冷落、旧时心"
        ]
      }
    },
    {
      "name": "柳永",
      "source_id": 608,
      "stanza1": {
        "lines": [
          "轻蹑/罗鞋/掩绮寮",
          "传音耗、若相招",
          "语声/犹颤/不成娇",
          "乍得见、两魂消"
        ]
      },
      "stanza2": {
        "lines": [
          "匆匆/草草/难留恋",
          "还归去、又无聊",
          "若谐/雨夕/与云朝",
          "得似箇、有嚣嚣"
        ]
      }
    }
  ]
}