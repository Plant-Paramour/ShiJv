{
  "name": "双雁儿",
  "variants": [
    {
      "name": "杨无咎",
      "source_id": 660,
      "stanza1": {
        "lines": [
          "穷阴/急景/暗推迁",
          "减绿鬓、损朱颜",
          "利名/牵役/几时閒",
          "又还惊、一岁圆"
        ]
      },
      "stanza2": {
        "lines": [
          "劝君/今夕/不须眠",
          "且慢慢、泛觥船",
