{
  "name": "无愁可解",
  "variants": [
    {
      "name": "苏轼",
      "source_id": 2111,
      "stanza1": {
        "lines": [
          "光景/百年",
          "看便/一世",
          "生来/不识/愁味",
          "问愁/何处来",
          "更开解/箇甚底",
          "万事/从来/风过耳",
          "又何用、著在/心里",
          "你唤做、展却/眉头",
          "便是/达者",
          "也则/恐未"
        ]
      },
      "stanza2": {
        "lines": [
          "此理",
          "本不/通言",
          "何曾道、欢游/胜如/名利",
          "道则/浑是错",
          "不道/如何/即是",
          "这里/元无/我与你",
          "甚唤做、物情/之外",
          "若须/待醉了",
          "方开/解时",
          "问无酒、怎生醉"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 2112,
      "stanza1": {
        "lines": [
          "返照/人间",
          "忙忙/劫劫",
          "昼夜/辛苦/无歇",
          "大都/能几许",
          "这百年、又如/春雪",
          "可惜/天真/逐爱慾",
          "似傀儡、被他/牵拽",
          "暗悲嗟、苦海/浮生",
          "改头/换面",
          "看/何时彻"
        ]
      },
      "stanza2": {
        "lines": [
          "听说",
          "古往/今来/名利客",
          "今祇有、兔踪/狐穴",
          "六朝/并五霸",
          "尽/输他、云水/英杰",
          "一味/真慵/为伴侣",
          "养浩然、岁寒/清节",
          "这些儿、冷淡/生涯",
          "与谁/共赏",
          "有/松窗月"
        ]
      }
    }
  ]
}