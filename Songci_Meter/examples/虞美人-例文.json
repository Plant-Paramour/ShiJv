{
  "name": "虞美人",
  "variants": [
    {
      "name": "（南唐）李煜",
      "source_id": 783,
      "stanza1": {
        "lines": [
          "风回/小院/庭芜绿",
          "柳眼/春相续",
          "凭阑/半日/独无言",
          "依旧/竹声/新月、似当年"
        ]
      },
      "stanza2": {
        "lines": [
          "笙歌/未散/尊罍在",
          "池面/冰初解",
          "烛明/香暗/画阑深",
          "满鬓/清霜/残雪、思难禁"
        ]
      }
    },
    {
      "name": "张炎",
      "source_id": 784,
      "stanza1": {
        "lines": [
          "修眉/刷翠/春痕聚",
          "难剪/愁来处",
          "断丝/无力/绾繁华",
          "也学/落花/流水、到天涯"
        ]
      },
      "stanza2": {
        "lines": [
          "那时/错认/章台去",
          "却是/阳关路",
          "待将/心恨/趁杨花",
          "不识/相思/一点、在谁家"
        ]
      }
    },
    {
      "name": "冯延巳",
      "source_id": 785,
      "stanza1": {
        "lines": [
          "玉鈎/鸾柱/调鹦鹉",
          "宛转/留春语",
          "云屏/冷落/画堂空",
          "薄晚/春寒/无奈、落花风"
        ]
      },
      "stanza2": {
        "lines": [
          "褰帘/燕子/低飞去",
          "拂镜/尘鸾舞",
          "不知/今夜/月眉弯",
          "谁佩/同心/双结、倚阑干"
        ]
      }
    },
    {
      "name": "毛文锡",
      "source_id": 786,
      "stanza1": {
        "lines": [
          "宝檀/金缕/鸳鸯枕",
          "绶带/盘宫锦",
          "夕阳/低映/小窗明",
          "南园/绿树/语莺莺",
          "梦难成"
        ]
      },
      "stanza2": {
        "lines": [
          "玉炉/香暖/频添注",
          "满地/飘轻絮",
          "珠帘/不卷/度沈烟",
          "庭前/閒立/画秋千",
          "艳阳天"
        ]
      }
    },
    {
      "name": "晁补之",
      "source_id": 787,
      "stanza1": {
        "lines": [
          "原桑/飞尽/霜空杳",
          "霜夜/愁难晓",
          "油灯/野店/怯黄昏",
          "穷途/不减/酒杯深",
          "故人心"
        ]
      },
      "stanza2": {
        "lines": [
          "羊山/古道/行人少",
          "也送/行人老",
          "一般/别语/重千金",
          "明年/过我/小园林",
          "话如今"
        ]
      }
    },
    {
      "name": "顾夐",
      "source_id": 788,
      "stanza1": {
        "lines": [
          "触帘/风送/景阳钟",
          "鸳被/绣花重",
          "晓帏/初卷/冷烟浓",
          "翠匀/粉黛/好仪容",
          "思娇慵"
        ]
      },
      "stanza2": {
        "lines": [
          "起来/无语/理朝妆",
          "宝匣/镜凝光",
          "绿荷/相倚/满池塘",
          "露清/枕簟/藕花香",
          "恨悠扬"
        ]
      }
    },
    {
      "name": "顾夐",
      "source_id": 789,
      "stanza1": {
        "lines": [
          "少年/艳质/胜琼英",
          "早晚/到三清",
          "莲冠/稳簪/细篦横",
          "飘飘/罗袖/碧云轻",
          "画难成"
        ]
      },
      "stanza2": {
        "lines": [
          "迟迟/少转/腰身裊",
          "翠靥/眉心小",
          "醮坛/风急/杏枝香",
          "此时/恨不/驾鸾凰",
          "访刘郎"
        ]
      }
    }
  ]
}