{
  "name": "菩萨蛮",
  "variants": [
    {
      "name": "李白",
      "source_id": 302,
      "stanza1": {
        "lines": [
          "平林/漠漠/烟如织",
          "寒山/一带/伤心碧",
          "暝色/入高楼",
          "有人/楼上愁"
        ]
      },
      "stanza2": {
        "lines": [
          "玉阶/空竚立",
          "宿鸟/归飞急",
          "何处/是归程",
          "长亭/更短亭"
        ]
      }
    },
    {
      "name": "朱敦儒",
      "source_id": 303,
      "stanza1": {
        "lines": [
          "秋风/乍起/梧桐落",
          "蛩吟/唧唧/添萧索",
          "敧枕/背灯眠",
          "月和/残梦圆"
        ]
      },
      "stanza2": {
        "lines": [
          "起来/鈎翠箔",
          "何处/寒砧作",
          "独倚/小阑干",
          "逼人/风露寒"
        ]
      }
    },
    {
      "name": "楼扶",
      "source_id": 304,
      "stanza1": {
        "lines": [
          "丝丝/杨柳莺/声近",
          "晚风/吹过/秋千影",
          "寒色/一帘轻",
          "灯残/梦不成"
        ]
      },
      "stanza2": {
        "lines": [
          "耳边/消息在",
          "笑指/花梢待",
          "又是/不归来",
          "满庭/花自开"
        ]
      }
    }
  ]
}