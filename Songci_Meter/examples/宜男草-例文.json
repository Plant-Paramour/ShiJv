          "问小桥、别后/谁过",
          "惟有/迷鸟/羁雌/来往"
        ]
      },
      "stanza2": {
        "lines": [
          "重寻/山水/问无恙",
          "扫柴荆、土花/尘网",
          "留小桃、先试/光风",
          "从此/芝草/琅玕/日长"
        ]
      }
    },
    {
      "name": "范成大",
      "source_id": 849,
      "stanza1": {
        "lines": [
          "篱菊/滩芦/被霜后",
          "裊长风、万重/高柳",
          "天为谁、展尽/湖光/渺渺",
          "应为我、扁舟/入手"
        ]
      },
      "stanza2": {
        "lines": [
          "橘中/曾醉/洞庭酒",
          "辗云涛、挂帆/南斗",
          "追旧游、不减/商山/杳杳",
          "犹有人、能相/记否"
        ]
      }
    }
  ]
