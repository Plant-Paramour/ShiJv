      "stanza1": {
        "lines": [
          "雪后/雨儿/雨后雪",
          "镇日价、长不歇",
          "今番/为寒/忒太切",
          "和天地、也来/厮别"
        ]
      },
      "stanza2": {
        "lines": [
          "睡不著、身心/自暗撷",
