{
  "name": "端正好",
  "variants": [
    {
      "name": "杜安世",
      "source_id": 698,
      "stanza1": {
        "lines": [
          "槛菊/愁烟/霑秋露",
          "天微冷、双燕/辞去",
          "月明/空照/别离苦",
          "透素光、穿朱户"
        ]
      },
      "stanza2": {
        "lines": [
          "夜来/西风/彫寒树",
          "凭阑望、迢遥/长路",
          "花笺/写就/此情绪",
          "待寄传、知何处"
        ]
      }
    },
    {
      "name": "杨无咎",
      "source_id": 699,
      "stanza1": {
        "lines": [
          "溅溅/不住/溪流素",
          "忆曾记、碧桃/红露",
          "别来/寂寞/朝朝暮",
          "恨遮断、当时路"
        ]
      },
      "stanza2": {
        "lines": [
          "仙家/岂解/空相误",
          "叹尘世、自难/知处",
          "而今/重与/春为主",
          "尽浪蕊、浮花妒"
        ]
      }
    }
  ]
}