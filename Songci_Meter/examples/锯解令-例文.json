{
  "name": "锯解令",
  "variants": [
    {
      "name": "杨无咎",
      "source_id": 659,
      "stanza1": {
        "lines": [
          "送人/归后/酒醒时",
          "睡不稳、衾翻/翠缕",
          "应将/别泪/洒西风",
          "尽化作、断肠/夜雨"
        ]
      },
      "stanza2": {
        "lines": [
          "卸帆/浦溆",
          "一种/悽惶/两处",
          "寻思/却是/我无情",
          "便不解、寄将/梦去"
        ]
      }
    }
  ]
}
