{
  "name": "系裙腰",
  "variants": [
    {
      "name": "张先",
      "source_id": 901,
      "stanza1": {
        "lines": [
          "清霜/蟾照/夜云天",
          "朦胧影、画勾阑",
          "人情/纵似/长情月",
          "算/一年年",
          "又能得",
          "几番圆"
        ]
      },
      "stanza2": {
        "lines": [
          "欲寄/西江/题叶字",
          "流不到、五亭前",
          "东池/始有/荷新绿",
          "尚小/如钱",
          "问何/日藕",
          "几时莲"
        ]
      }
    },
    {
      "name": "刘儗",
      "source_id": 902,
      "stanza1": {
        "lines": [
          "山儿/矗矗/水儿清",
          "船儿似、叶儿轻",
          "风儿/更没/人情",
          "月儿明",
          "厮合造",
          "送人行"
        ]
      },
      "stanza2": {
        "lines": [
          "眼儿/蔌蔌/泪儿倾",
          "灯儿更、冷青青",
          "遭逢著、雁儿/又没/前程",
          "一声声",
          "怎生得、梦儿成"
        ]
      }
    },
    {
      "name": "宋媛魏氏",
      "source_id": 903,
      "stanza1": {
        "lines": [
          "灯花/耿耿/漏迟迟",
          "人别后、夜凉时",
          "西风/潇洒/梦初回",
          "谁念我",
          "就单枕",
          "皱双眉"
        ]
      },
      "stanza2": {
        "lines": [
          "锦屏/绣幌/与秋期",
          "肠欲断、泪偷垂",
          "月明/还到/小窗西",
          "我恨你",
          "我忆你",
          "你爭知"
        ]
      }
    }
  ]
}