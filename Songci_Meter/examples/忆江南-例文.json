{
  "name": "忆江南",
  "variants": [
    {
      "name": "白居易",
      "source_id": 50,
      "stanza1": {
        "lines": [
          "江南/好",
          "风景/旧曾谙",
          "日出/江花/红胜火",
          "春来/江水/绿如蓝",
          "能不/忆江南"
        ]
      }
    },
    {
      "name": "欧阳修",
      "source_id": 51,
      "stanza1": {
        "lines": [
          "江南蝶",
          "斜日/一双双",
          "身似/何郎/曾傅粉",
          "心如/韩寿/爱偷香",
          "天赋/与轻狂"
        ]
      },
      "stanza2": {
        "lines": [
          "微雨过",
          "薄翅/腻烟光",
          "纔伴/游蜂/来小苑",
          "又随/飞絮/过东墙",
          "长是/为花忙"
        ]
      }
    },
    {
      "name": "冯延巳",
      "source_id": 52,
      "stanza1": {
        "lines": [
          "去岁/迎春/楼上月",
          "正是/西窗",
          "夜凉/时节",
          "玉人/贪睡/坠钗云",
          "粉销/妆薄/见天真"
        ]
      },
      "stanza2": {
        "lines": [
          "人非/风月/长依旧",
          "破镜/尘筝",
          "一梦/经年瘦",
          "今宵/帘幕/飏花阴",
          "空余/枕泪/独伤心"
        ]
      }
    }
  ]
}