{
  "name": "惜分飞",
  "variants": [
    {
      "name": "毛滂",
      "source_id": 567,
      "stanza1": {
        "lines": [
          "泪湿/阑干/花著露",
          "愁到/眉峰/碧聚",
          "此恨/平分取",
          "更无/言语",
          "空相觑"
        ]
      },
      "stanza2": {
        "lines": [
          "短雨/残云/无意绪",
          "寂寞/朝朝/暮暮",
          "今夜/山深处",
          "断魂/分付",
          "潮/回去"
        ]
      }
    },
    {
      "name": "刘弇",
      "source_id": 568,
      "stanza1": {
        "lines": [
          "风外/橘花/香暗度",
          "飞絮绾、残春/归去",
          "酝造/黄梅雨",
          "冷烟/晓占/横塘路"
        ]
      },
      "stanza2": {
        "lines": [
          "翠屏/人在/天低处",
          "惊梦断、行云/无据",
          "此恨/凭谁诉",
          "恁时/却倩/危絃语"
        ]
      }
    },
    {
      "name": "张先",
      "source_id": 569,
      "stanza1": {
        "lines": [
          "城上/层楼/天边路",
          "残照里、平芜/绿树",
          "伤远/更惜/春暮",
          "有人/还在/高高处"
        ]
      },
      "stanza2": {
        "lines": [
          "断梦/归云/经日去",
          "无计使、哀絃/寄语",
          "相望/恨不/相遇",
          "倚桥/临水/谁家住"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 570,
      "stanza1": {
        "lines": [
          "庾岭/香前/亲写得",
          "仔细看、粉匀/无迹",
          "月殿/休寻觅",
          "姑射/人来、知是/曾相识"
        ]
      },
      "stanza2": {
        "lines": [
          "不要/青春/閒用力",
          "也合寄、江南/资讯",
          "著意/应难摘",
          "留与/梨花、比并/真颜色"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 571,
      "stanza1": {
        "lines": [
          "冒雪/披风/开数点",
          "万花压、欺寒/探暖",
          "掩映/閒庭院",
          "月下/疏影/横斜、幽香远"
        ]
      },
      "stanza2": {
        "lines": [
          "命友/开尊/閒宴翫",
          "听丽质、歌声/宛转",
          "对景/侧金盏",
          "任他/结实/和羹、归仙馆"
        ]
      }
    }
  ]
