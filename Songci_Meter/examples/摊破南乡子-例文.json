{
  "name": "摊破南乡子",
  "variants": [
    {
      "name": "程垓",
      "source_id": 923,
      "stanza1": {
        "lines": [
          "休赋/惜春诗",
          "留春住、说与人知",
          "一年/已负/东风瘦",
          "说愁/说恨",
          "数期/数刻",
          "只望/归时"
        ]
      },
      "stanza2": {
        "lines": [
          "莫怪/杜鹃啼",
          "真箇也、唤得/人归",
          "归来/休恨/花开了",
          "梁间/燕子",
          "且教/知道",
          "人也/双飞"
        ]
      }
    },
    {
      "name": "赵长卿",
      "source_id": 924,
      "stanza1": {
        "lines": [
          "最苦/是离愁",
          "行坐里、只在/心头",
          "待须/作箇/巫山梦",
          "孤衾/辗转",
          "无眠/到晓",
          "和梦/都休"
        ]
      },
      "stanza2": {
        "lines": [
          "梦里/也无由",
          "谁敢望、真箇/绸缪",
          "暂时/不见/浑閒事",
          "只愁/柳絮/杨花",
          "自来/摆荡/难留"
        ]
      }
    }
  ]
}