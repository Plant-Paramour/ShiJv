{
  "name": "一落索",
  "variants": [
    {
      "name": "无名氏",
      "source_id": 323,
      "stanza1": {
        "lines": [
          "腊后/东风/微透",
          "越梅/时候",
          "一枝/芳信/到江南",
          "来报/先春秀"
        ]
      },
      "stanza2": {
        "lines": [
          "宿醉/频拈/轻嗅",
          "堪醒/残酒",
          "笛声/容易/莫相催",
          "留待/纤纤手"
        ]
      }
    },
    {
      "name": "吕渭老",
      "source_id": 324,
      "stanza1": {
        "lines": [
          "宫锦/裁书/寄远",
          "意长/辞短",
          "香兰/泣露/雨催莲",
          "暑气/昏池馆"
        ]
      },
      "stanza2": {
        "lines": [
          "向晚/小园/行遍",
          "石榴/红满",
          "花花/叶叶/尽成双",
          "浑似我、梁间燕"
        ]
      }
    },
    {
      "name": "毛滂",
      "source_id": 325,
      "stanza1": {
        "lines": [
          "月下/花前/风畔",
          "此情/不浅",
          "欲留/风月/守花枝",
          "却不道、而今远"
        ]
      },
      "stanza2": {
        "lines": [
          "墙外/鹭飞/沙晚",
          "烟斜/雨短",
          "青山/祇管/一重重",
          "向东下、遮人眼"
        ]
      }
    },
    {
      "name": "张先",
      "source_id": 326,
      "stanza1": {
        "lines": [
          "来时/露浥/衣香润",
          "彩绦/垂鬓",
          "卷帘/还喜/月相亲",
          "把酒与、花相近"
        ]
      },
      "stanza2": {
        "lines": [
          "西去/阳关/休问",
          "未歌/先恨",
          "玉峰/山下/水长流",
          "流水尽、情无尽"
        ]
      }
    },
    {
      "name": "秦观",
      "source_id": 327,
      "stanza1": {
        "lines": [
          "杨花/终日/飞舞",
          "奈久长/难驻",
          "海潮/虽是/暂时来",
          "却有箇、堪凭处"
        ]
      },
      "stanza2": {
        "lines": [
          "紫府/碧云/为路",
          "好相将/归去",
          "肯如/薄幸/五更风",
          "不解与、花为主"
        ]
      }
    },
    {
      "name": "严仁",
      "source_id": 328,
      "stanza1": {
        "lines": [
          "清晓/莺啼/红树",
          "又一双/飞去",
          "日高/花气/扑人/来",
          "独自箇、伤春/无绪"
        ]
      },
      "stanza2": {
        "lines": [
          "别后/暗宽/金缕",
          "倩谁/传语",
          "一春/不忍/上高楼",
          "为怕见、分携处"
        ]
      }
    },
    {
      "name": "陈凤仪",
      "source_id": 329,
      "stanza1": {
        "lines": [
          "蜀江/春色/浓如雾",
          "拥/双旌/归去",
          "海棠/也似/别君难",
          "一点点、啼红雨"
        ]
      },
      "stanza2": {
        "lines": [
          "此去/马蹄何处",
          "向沙堤/新路",
          "禁林/赐宴/赏花时",
          "还忆著、西楼否"
        ]
      }
    },
    {
      "name": "欧阳修",
      "source_id": 330,
      "stanza1": {
        "lines": [
          "红纱/未晓/黄鹂语",
          "蕙炉/消残炷",
          "锦屏/罗幕/护春寒",
          "昨夜里、三更雨"
        ]
      },
      "stanza2": {
        "lines": [
          "绣帘/閒倚/吹轻絮",
          "敛眉山/无绪",
          "看花/拭泪/向归鸿",
          "问来处、逢郎否"
        ]
      }
    }
  ]
}