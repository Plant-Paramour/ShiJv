{
  "name": "紫萸香慢",
  "variants": [
    {
      "name": "姚云文",
      "source_id": 2173,
      "stanza1": {
        "lines": [
          "近重阳、偏多/风雨",
          "绝怜/此日/暄明",
          "问/秋香/浓未",
          "待携客",
          "出西城",
          "正自/羁怀/多感",
          "怕/荒台/高处",
          "更/不胜情",
          "向尊前、又忆/漉酒/插花人",
          "只座上、已无/老兵"
        ]
      },
      "stanza2": {
        "lines": [
          "凄清",
          "浅醉/还醒",
          "愁不肯、与诗平",
          "记/长楸/走马",
          "雕弓/笮柳",
          "前事/休评",
          "紫萸/一枝/传赐",
          "梦谁到、汉家陵",
          "尽乌纱、便/随风去",
          "要/天知道",
          "华发/如此/星星",
          "歌罢/涕零"
        ]
      }
    }
  ]
