{
  "name": "谒金门",
  "variants": [
    {
      "name": "韦庄",
      "source_id": 332,
      "stanza1": {
        "lines": [
          "空相忆",
          "无计/得传/消息",
          "天上/嫦娥/人不识",
          "寄书/何处觅"
        ]
      },
      "stanza2": {
        "lines": [
          "新睡觉/来无力",
          "不忍/看伊/书迹",
          "满院/落花/春寂寂",
          "断肠/芳草碧"
        ]
      }
    },
    {
      "name": "孙光宪",
      "source_id": 333,
      "stanza1": {
        "lines": [
          "留不得",
          "留得/也应/无益",
          "白纻/春衫/如/雪色",
          "扬州/初去日"
        ]
      },
      "stanza2": {
        "lines": [
          "轻别离",
          "甘抛掷",
          "江上/满帆/风疾",
          "却羡/彩鸳/三十六",
          "孤鸾/还一只"
        ]
      }
    },
    {
      "name": "周必大",
      "source_id": 334,
      "stanza1": {
        "lines": [
          "梅乍吐",
          "趁宴席、香风度",
          "人与/此花/俱独步",
          "风流/天付与"
        ]
      },
      "stanza2": {
        "lines": [
          "好在/青云/岐路",
          "愿共作、和羹侣",
          "归访/赤松/辞万户",
          "莺花/犹是主"
        ]
      }
    },
    {
      "name": "程过",
      "source_id": 335,
      "stanza1": {
        "lines": [
          "江上路",
          "依约/数家/烟树",
          "一枕/归心/邨店暮",
          "更乱山/深处"
        ]
      },
      "stanza2": {
        "lines": [
          "梦过/江南/芳草渡",
          "晓色/又催/人去",
          "愁似/游丝/千万缕",
          "倩东风/约住"
        ]
      }
    }
  ]
}