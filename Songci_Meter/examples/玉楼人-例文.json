{
  "name": "玉楼人",
  "variants": [
    {
      "name": "无名氏",
      "source_id": 715,
      "stanza1": {
        "lines": [
          "去年/寻处/曾持酒",
          "还是向、南枝/见后",
          "宜霜/宜雪/精神",
          "没些儿、风味/减旧"
        ]
      },
      "stanza2": {
        "lines": [
          "先春/似与/群芳鬭",
          "暗度香、不待/频嗅",
          "有人/笑折/归来",
          "玉纤长、尽露/衫袖"
        ]
      }
    }
  ]
}