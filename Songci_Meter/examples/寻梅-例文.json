{
  "name": "寻梅",
  "variants": [
    {
      "name": "沈会宗",
      "source_id": 883,
      "stanza1": {
        "lines": [
          "今年/早觉/花信蹉",
          "想芳心、未应/误我",
          "一月/花信/几回过",
          "始朝来/寻见",
          "雪痕/微破"
        ]
      },
      "stanza2": {
        "lines": [
          "眼前/大抵/情无那",
          "好景色、只消/些箇",
          "春风/烂漫/都且可",
          "是而今/枝上",
          "三朵/两朵"
        ]
      }
    },
    {
      "name": "沈会宗",
      "source_id": 884,
      "stanza1": {
        "lines": [
          "幽香/浅浅/湿未透",
          "认雪底、思来/始有",
          "剪裁/尚觉/琼瑶皱",
          "苦寒中",
          "越恁/骨清/肌瘦"
        ]
      },
      "stanza2": {
        "lines": [
          "东风/气象/园林旧",
          "又今年、而今/时候",
          "急宜/小摘/当尊酒",
          "选一枝",
          "且付/玉人/纤手"
        ]
      }
    }
  ]
}