{
  "name": "菊花新",
  "variants": [
    {
      "name": "张先",
      "source_id": 634,
      "stanza1": {
        "lines": [
          "堕髻/慵妆/来日暮",
          "家在/柳桥/堤下住",
          "衣缓/绛绡垂",
          "琼树裊、一枝/红雾"
        ]
      },
      "stanza2": {
        "lines": [
          "院深/池静/花相妒",
          "粉墙低、乐声/时度",
          "长恐/舞筵空",
          "轻化作、彩云/飞去"
        ]
      }
    },
    {
      "name": "杜安世",
      "source_id": 635,
      "stanza1": {
        "lines": [
          "怎奈/花残/莺又老",
          "槛里/青梅/数枝小",
          "新荷/长池沼",
          "当晴昼、燕子/声闹"
        ]
      },
      "stanza2": {
        "lines": [
          "亭阑/花绽/颜色好",
          "风雨催、等閒开了",
          "酒醒/暗思量",
          "无箇事、著甚/烦恼"
        ]
      }
    }
  ]
}
