      "stanza1": {
        "lines": [
          "瑶阶/月色/晃疏棂",
          "银烛/秋光/冷画屏",
          "消遣/此时/此夜景",
          "步閒庭",
          "苔浸/凌波/罗袜冷"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 109,
      "stanza1": {
        "lines": [
          "湖上/风来/波浩渺",
          "秋已暮、红稀/香少",
          "水光/山色/与人亲",
          "说不尽、无穷好",
          "莲子/已成/荷叶老",
          "清露洗、苹花/汀草",
          "眠沙/鸥鹭/不回头",
          "似应恨、人归早"
        ]
      }
    }
  ]
