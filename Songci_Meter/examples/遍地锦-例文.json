{
  "name": "遍地锦",
  "variants": [
    {
      "name": "毛滂",
      "source_id": 813,
      "stanza1": {
        "lines": [
          "白玉/阑边/自凝竚",
          "满枝头、彩云/雕雾",
          "甚芳菲、绣得/成团",
          "砌合出、韶华/好处"
        ]
      },
      "stanza2": {
        "lines": [
          "暖风前、一笑/盈盈",
          "吐檀心、向谁/分付",
          "莫与他、西子/精神",
          "不枉了、东君/雨露"
        ]
      }
    }
  ]
}