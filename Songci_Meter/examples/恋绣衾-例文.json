{
  "name": "恋绣衾",
  "variants": [
    {
      "name": "朱敦儒",
      "source_id": 704,
      "stanza1": {
        "lines": [
          "木落/江南/感未平",
          "雨潇潇、衰鬓/到今",
          "甚处是、长安路",
          "水连空、山锁/暮云"
        ]
      },
      "stanza2": {
        "lines": [
          "老人/对酒/今如此",
          "一番新、残梦/暗惊",
          "又是洒、黄花泪",
          "问/明年、此会/怎生"
        ]
      }
    },
    {
      "name": "周密",
      "source_id": 705,
      "stanza1": {
        "lines": [
          "粉黄/衣薄/沾麝熏",
          "作南华、春梦/乍醒",
          "活计/一生/花里",
          "恨晓园、花露/正深"
        ]
      },
      "stanza2": {
        "lines": [
          "芳溪/有恨/时时见",
          "趁游丝、高下/弄晴",
          "生怕被/春归了",
          "赶春风、低度/柳阴"
        ]
      }
    },
    {
      "name": "辛弃疾",
      "source_id": 706,
      "stanza1": {
        "lines": [
          "长夜/偏冷/添被儿",
          "枕头儿、移了/又移",
          "我自是、笑别/人底",
          "却原来、当局者迷"
        ]
      },
      "stanza2": {
        "lines": [
          "如今/只恨/姻缘浅",
          "也不会、抵死/恨伊",
          "合手下、安排了",
          "那筵席、须有/散时"
        ]
      }
    },
    {
      "name": "韩淲",
      "source_id": 707,
      "stanza1": {
        "lines": [
          "欢浓/雨点/笑靥儿",
          "雪初消、梅欲放时",
          "不信道、伤春/瘦",
          "怕人猜、犹待/皱眉"
        ]
      },
      "stanza2": {
        "lines": [
          "香浓/翠被/屏山曲",
          "把/珊瑚枕、侧过/又移",
          "试与伴、江头去",
          "但/醉翁亭上/要诗"
        ]
      }
    },
    {
      "name": "赵汝茪",
      "source_id": 708,
      "stanza1": {
        "lines": [
          "柳丝/空有/万千条",
          "系不住、溪头/画桡",
          "想今宵、也对/新月",
          "过轻寒、何处/小桥"
        ]
      },
      "stanza2": {
        "lines": [
          "玉箫/台榭/春多少",
          "溜啼痕、盈脸/未消",
          "怪别来、胭脂/慵傅",
          "被东风、偷在/杏梢"
        ]
      }
    }
  ]
}