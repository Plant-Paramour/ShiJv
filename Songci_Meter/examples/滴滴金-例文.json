{
  "name": "滴滴金",
  "variants": [
    {
      "name": "李遵勖",
      "source_id": 538,
      "stanza1": {
        "lines": [
          "帝城/五夜/宴游歇",
          "残灯外、看残月",
          "都来/犹在/醉乡中",
          "听/更漏/初彻"
        ]
      },
      "stanza2": {
        "lines": [
          "行乐/已成/閒话/说",
          "如春梦、觉时节",
          "大家/同约/探春行",
          "问/甚花/先发"
        ]
      }
    },
    {
      "name": "晏殊",
      "source_id": 539,
      "stanza1": {
        "lines": [
          "梅花/漏泄/春消息",
          "柳丝长、草芽碧",
          "不觉/星霜/鬓边白",
          "念/时光/堪惜"
        ]
      },
      "stanza2": {
        "lines": [
          "兰堂/把酒/留佳客",
          "对离筵、驻行色",
          "千里/音尘/便疏隔",
          "合有/人相忆"
        ]
      }
    },
    {
      "name": "杨无咎",
      "source_id": 540,
      "stanza1": {
        "lines": [
          "相逢/未尽/论心素",
          "早容易、背人去",
          "忆得/歌翻/肠断句",
          "更/惺惺/言语"
        ]
      },
      "stanza2": {
        "lines": [
          "萋萋/芳草/迷南浦",
          "正风吹、打船雨",
          "静听/愁声/夜无眠",
          "到/水邨/何处"
        ]
      }
    },
    {
      "name": "孙道绚",
      "source_id": 541,
      "stanza1": {
        "lines": [
          "月光/飞入/林前屋",
          "风簌簌、度庭竹",
          "夜半/江城/击柝声",
          "动/寒梢/栖宿"
        ]
      },
      "stanza2": {
        "lines": [
          "等閒/老去/年华促",
          "祇有/江梅/伴幽独",
          "梦绕/夷门/旧家山",
          "恨/惊回/难续"
        ]
      }
    }
  ]
}