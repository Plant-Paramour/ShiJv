{
  "name": "夜游宫",
  "variants": [
    {
      "name": "毛滂",
      "source_id": 832,
      "stanza1": {
        "lines": [
          "长记/劳君/送远",
          "柳烟重、桃花/波暖",
          "花外/溪城/望不见",
          "古槐边",
          "故人稀",
          "秋鬓晚"
        ]
      },
      "stanza2": {
        "lines": [
          "我有/凌霄伴",
          "在何处、山寒/云乱",
          "何不/随君/弄清浅",
          "见伊时",
          "话阳春",
          "山数点"
        ]
      }
    },
    {
      "name": "贺铸",
      "source_id": 833,
      "stanza1": {
        "lines": [
          "湖上/兰舟/暮发",
          "扬州/梦断/灯明灭",
          "想见/琼花/开似雪",
          "帽檐香",
          "玉纤纤",
          "曾为折"
        ]
      },
      "stanza2": {
        "lines": [
          "渔管/吹还咽",
          "问何意、并人/愁绝",
          "江北/江南/新念别",
          "掩芳尊",
          "与谁同",
          "今夜月"
        ]
      }
    }
  ]
}