{
  "name": "忆汉月",
  "variants": [
    {
      "name": "欧阳修",
      "source_id": 542,
      "stanza1": {
        "lines": [
          "红艳/几枝/轻裊",
          "早被/东风/开了",
          "倚烟/啼露/为谁娇",
          "故惹/蝶怜/蜂恼"
        ]
      },
      "stanza2": {
        "lines": [
          "多情/游赏处",
          "留恋向、绿丛/千绕",
          "酒阑/欢罢/不成归",
          "肠断/月斜/人老"
        ]
      }
    },
    {
      "name": "柳永",
      "source_id": 543,
      "stanza1": {
        "lines": [
          "明月/明月/明月",
          "何事/乍圆/还缺",
          "恰如/年少/洞房人",
          "欢会/依前/离别"
        ]
      },
      "stanza2": {
        "lines": [
          "小楼/凭槛处",
          "正是/去年/时节",
          "千里/清光/又依旧",
          "奈夜永、厌厌/人绝"
        ]
      }
    },
    {
      "name": "杜安世",
      "source_id": 544,
      "stanza1": {
        "lines": [
          "红杏/一枝/遥见",
          "凝露/粉愁/香怨",
          "吹开/吹谢/任春风",
          "恨流莺、不能/拘管"
        ]
      },
      "stanza2": {
        "lines": [
          "曲池/连夜雨",
          "绿水上、碎红/千片",
          "直拟/移来/向深苑",
          "任彫零、不孤/双眼"
        ]
      }
    },
    {
      "name": "李遵勖",
      "source_id": 545,
      "stanza1": {
        "lines": [
          "黄菊/一丛/临砌",
          "颗颗/露珠/装缀",
          "独教/冷落/向秋天",
          "恨东风、不曾/留意"
        ]
      },
      "stanza2": {
        "lines": [
          "雕阑/新雨霁",
          "绿藓上、乱铺/金蕊",
          "此花/开后/更无花",
          "愿爱惜、莫同/桃李"
        ]
      }
    }
  ]
}