      "stanza1": {
        "lines": [
          "暗香/浮动/到黄昏",
          "向水边、疏影/梅开尽",
          "溪畔/清蕊",
          "有如/浅杏",
          "一枝/喜得/东君信"
        ]
      },
      "stanza2": {
        "lines": [
          "风吹/只怕/霜侵损",
          "更新来、插向/多情鬓",
          "寿阳/妆鉴",
          "雪肌/玉莹",
          "岭头/别自/添微粉"
        ]
      }
    }
  ]
