          "斜晖/脉脉",
          "西风/吹梦/来无迹"
        ]
      }
    },
    {
      "name": "蔡伸",
      "source_id": 874,
      "stanza1": {
        "lines": [
          "天涯/触目/伤离绪",
          "登临/况值/秋光暮",
          "手捻/黄花",
          "凭谁/分付",
          "雝雝/雁落/蒹葭浦"
        ]
      },
      "stanza2": {
        "lines": [
          "凭高/目断/桃溪路",
          "屏山/楼外/青无数",
          "绿水/红桥",
          "琐窗/朱户",
          "如今/总是/销魂处"
        ]
      }
    },
    {
      "name": "无名氏",
