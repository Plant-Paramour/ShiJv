{
  "name": "市桥柳",
  "variants": [
    {
      "name": "蜀妓",
      "source_id": 828,
      "stanza1": {
        "lines": [
          "欲寄意、浑无/所有",
          "折尽/市桥/官柳",
          "看君/著上/征衫",
          "又相将、放船/楚江口"
        ]
      },
      "stanza2": {
        "lines": [
          "后会/不知/何日又",
          "是男儿、休要/镇长相守",
          "苟富贵、无相忘",
          "若相忘、有如/此酒"
        ]
      }
    }
  ]
}