{
  "name": "鹦鹉曲",
  "variants": [
    {
      "name": "白无咎",
      "source_id": 718,
      "stanza1": {
        "lines": [
          "侬家/鹦鹉洲/边住",
          "是箇/不识字/渔父",
          "浪花中、一叶/扁舟",
          "睡煞/江南/烟雨"
        ]
      },
      "stanza2": {
        "lines": [
          "觉来时、满眼/青山",
          "抖擞/绿蓑/归去",
          "算从前、错怨/天公",
          "甚也有、安排/我处"
        ]
      }
    }
  ]
}