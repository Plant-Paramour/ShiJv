{
  "name": "杏花天",
  "variants": [
    {
      "name": "朱敦儒",
      "source_id": 700,
      "stanza1": {
        "lines": [
          "浅春/庭院/东风晓",
          "细雨打、鸳鸯/寒悄",
          "花尖/望见/秋千了",
          "无路/踏青/鬭草"
        ]
      },
      "stanza2": {
        "lines": [
          "人别后、碧云/信杳",
          "对/好景、愁多/欢少",
          "等他/燕子/传音耗",
          "红杏/开还/未到"
        ]
      }
    },
    {
      "name": "侯寘",
      "source_id": 701,
      "stanza1": {
        "lines": [
          "宝钗/整鬓/双鸾鬭",
          "睡纔醒、薰风/襟袖",
          "彩丝/皓腕/宜清昼",
          "更艾虎、衫儿/新就"
        ]
      },
      "stanza2": {
        "lines": [
          "玉杯/共饮/菖蒲酒",
          "愿耐夏、宜春/厮守",
          "榴花/故意/红添皱",
          "映得/人来/越瘦"
        ]
      }
    },
    {
      "name": "卢炳",
      "source_id": 702,
      "stanza1": {
        "lines": [
          "镂冰/剪玉/工夫费",
          "做六出、飞花/乱坠",
          "舞风/情态/谁相似",
          "算祇有、江梅/可比"
        ]
      },
      "stanza2": {
        "lines": [
          "极目处、琼瑶/万里",
          "海天阔、清寒/似水",
          "从教/高卷/珠帘起",
          "看三白、丰年/瑞气"
        ]
      }
    }
  ]
}