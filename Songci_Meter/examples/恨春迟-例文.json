{
  "name": "恨春迟",
  "variants": [
    {
      "name": "张先",
      "source_id": 860,
      "stanza1": {
        "lines": [
          "好梦/才成/成又断",
          "因晚起、云朵/梳鬟",
          "秀脸/拂轻红",
          "滴入/娇眉眼",
          "薄衣/减春寒"
        ]
      },
      "stanza2": {
        "lines": [
          "红柱/溪桥/波平岸",
          "画阁外、落日/西山",
          "不忿/閒花/并蒂",
          "秋藕/连根",
          "何时/重得/双莲"
        ]
      }
    }
  ]
}
