{
  "name": "迎春乐",
  "variants": [
    {
      "name": "柳永",
      "source_id": 625,
      "stanza1": {
        "lines": [
          "近来/憔悴/人惊怪",
          "为别后、相思煞",
          "我前生、负你/愁烦债",
          "便苦恁、难开解"
        ]
      },
      "stanza2": {
        "lines": [
          "良夜永、牵情/无奈",
          "锦被里、余香/犹在",
          "怎得/依前/灯下",
          "恣意/怜娇态"
        ]
      }
    },
    {
      "name": "晏殊",
      "source_id": 626,
      "stanza1": {
        "lines": [
          "长安/紫陌/春归早",
          "亸垂杨、染芳草",
          "被啼莺、语燕/催清晓",
          "正好梦、频惊觉"
        ]
      },
      "stanza2": {
        "lines": [
          "当此际、青楼/临大道",
          "幽会处、两情/多少",
          "莫惜/明珠/百琲",
          "占取/长年少"
        ]
      }
    },
    {
      "name": "秦观",
      "source_id": 627,
      "stanza1": {
        "lines": [
          "菖蒲/叶叶/知多少",
          "惟有箇、蜂儿妙",
          "雨晴/红粉/齐开了",
          "露一点、娇黄小"
        ]
      },
      "stanza2": {
        "lines": [
          "早是被、晓风/力暴",
          "更春共、斜阳/俱老",
          "怎得/花香/深处",
          "作箇/蜂儿/抱"
        ]
      }
    },
    {
      "name": "杨无咎",
      "source_id": 628,
      "stanza1": {
        "lines": [
          "新来/特特/更门地",
          "都收拾、山和水",
          "看明年、事事/如意",
          "迎福禄、俱来至"
        ]
      },
      "stanza2": {
        "lines": [
          "莫管/明朝/添一岁",
          "尽同向、尊前/沈醉",
          "且共唱、迎春乐",
          "祝母/千秋岁"
        ]
      }
    },
    {
      "name": "贺铸",
      "source_id": 629,
      "stanza1": {
        "lines": [
          "云鲜/日嫩/东风软",
          "雪初融、水清浅",
          "低鬟/舞按/迎春遍",
          "似飞动、钗头燕"
        ]
      },
      "stanza2": {
        "lines": [
          "漫折/梅花/曾寄远",
          "问谁为、倚楼/凄怨",
          "身伴/未归鸿",
          "犹顾恋、江南暖"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 630,
      "stanza1": {
        "lines": [
          "神州/丽景/春先到",
          "看看是、韶光早",
          "园林/深处/东风过",
          "红杏里、莺声好"
        ]
      },
      "stanza2": {
        "lines": [
          "漠漠/青烟/远远道",
          "触目是、绿杨/芳草",
          "莫惜/醉重游",
          "逡巡又、年华老"
        ]
      }
    },
    {
      "name": "周邦彦",
      "source_id": 631,
      "stanza1": {
        "lines": [
          "清池/小圃/开云屋",
          "结春伴、往来熟",
          "忆年时、纵酒/杯行速",
          "看月上、归禽宿"
        ]
      },
      "stanza2": {
        "lines": [
          "墙里/修篁/森似束",
          "记名字、曾刊/新绿",
          "见说/别来长",
          "冷翠藓",
          "封寒玉"
        ]
      }
    }
  ]
}