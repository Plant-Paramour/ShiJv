          "泛苹汀、步迷/花曲",
          "衣巾/散余馥",
          "种竹/更洗竹",
          "咏竹/题竹",
          "日暮/无人/伴幽独"
        ]
      },
      "stanza2": {
        "lines": [
          "光阴/双转毂",
          "可惜许、等閒/愁万斛",
          "世间/种种",
          "只是/荣和辱",
          "念足/又愿足",
          "意足/心足",
          "忘了/眉头/怎生蹙"
        ]
      },
