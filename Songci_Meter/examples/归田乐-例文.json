{
  "name": "归田乐",
  "variants": [
    {
      "name": "晁补之",
      "source_id": 562,
      "stanza1": {
        "lines": [
          "春又去",
          "似别/佳人/幽恨积",
          "閒庭院",
          "翠阴满、添昼寂",
          "一枝梅/最好",
          "至今忆"
        ]
      },
      "stanza2": {
        "lines": [
          "正梦断、炉烟裊",
          "参差/疏帘隔",
          "为何事、年年/春恨",
          "问花/应会得"
        ]
      }
    },
    {
      "name": "蔡伸",
      "source_id": 563,
      "stanza1": {
        "lines": [
          "风生/苹末/莲香细",
          "新浴/晚凉/天气",
          "独自/倚朱阑",
          "波面/双双/彩鸳戏"
        ]
      },
      "stanza2": {
        "lines": [
          "鸾钗/委坠/云堆髻",
          "谁会/此时/情意",
          "冰簟/玉琴/横",
          "还是/月明/人千里"
        ]
      }
    },
    {
      "name": "晏几道",
      "source_id": 564,
      "stanza1": {
        "lines": [
          "试把/花期数",
          "便早有、感春/情绪",
          "看即/梅花吐",
          "愿花/更不谢",
          "春且/长住",
          "只恐/花飞/又春去"
        ]
      },
      "stanza2": {
        "lines": [
          "花开/还不语",
          "问此意、年年/春会否",
          "绛唇/青鬓",
          "渐少/花前侣",
          "对花/又记得",
          "旧曾/游处",
          "门外/垂杨/未飘絮"
        ]
      }
    },
    {
      "name": "无名氏",
      "source_id": 565,
      "stanza1": {
        "lines": [
