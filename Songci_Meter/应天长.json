{
  "name": "应天长",
  "aliases": [],
  "description": "此调有令词、慢词。令词始于韦庄，又有顾夐、毛文锡两体。宋毛幵词名《应天长令》。慢词始于柳永，《乐章集》注“林钟商调”。又有周邦彦一体，名《应天长慢》。",
  "default_variant": "柳永",
  "default_variant_source_id": 512,
  "variants": [
    {
      "name": "韦庄",
      "source_id": 508,
      "length_category": "short",
      "variants_description": "此调始于此词，顾词、冯词由此减字，毛词由此或添字、或减字，实正体也。韦词 别首“别来半岁”词，牛峤“双眉淡薄”词，宋毛幵“曲阑十二”词，正与之同。\n按牛词前段起句“双眉淡薄藏心事”，“淡”字仄声。韦词别首第三、四句“难相见，易相别”，“易”字仄声。牛词结句“宝帐鸳鸯春睡美”，“鸳”字平声。谱内可平可仄据之，其余参下所采令词。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          4,
          5
        ],
        "lines": [
          "中中/中中/平中仄",
          "中仄/中平/平仄仄",
          "中平中",
          "中中仄",
          "中仄/中平/平仄仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          3,
          4,
          5
        ],
        "lines": [
          "仄平平",
          "平仄仄",
          "中仄/中平/平仄",
          "中仄/中平/中仄",
          "中中/中中仄"
        ]
      }
    },
