          1,
          2,
          4
        ],
        "lines": [
          "仄仄/平平/平仄仄",
          "中仄/中平/中中仄",
          "平仄/仄平平",
          "平中仄、中中/平仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          1,
