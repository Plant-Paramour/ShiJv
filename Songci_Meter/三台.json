{
  "name": "三台",
  "aliases": [],
  "description": "唐教坊曲名。宋李济翁《资暇录》：《三台》，今之啐酒三十拍促曲，啐，送酒声也。宋张表臣《珊瑚鈎诗话》：乐部中有促拍催酒，谓之《三台》。沈括词名《开元乐》，因结有“翠华满陌东风”句，名《翠华引》。",
  "default_variant": "王建",
  "default_variant_source_id": 30,
