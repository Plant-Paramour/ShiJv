    {
      "name": "曹冠",
      "source_id": 474,
      "length_category": "short",
      "variants_description": "此调采词五体，无叠句者两体，有叠句者三体。曹词换头第三句六字折腰。袁词七字折腰。赵词换头与曹词同。辛词换头一首与曹词同而起句多一字，一首与袁词同而句法不作上三下四，其余则无不同也。故此词可平可仄即校后词。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          3,
          4
        ],
        "lines": [
          "中平/平仄仄",
          "平中/中平仄",
          "平平/仄仄/平平仄",
          "中平/平仄仄"
        ]
      },
      "stanza2": {
        "rhyme_1_positions": [
          2,
          3,
          4,
          5
        ],
        "lines": [
          "平平/仄仄",
