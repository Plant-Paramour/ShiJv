{
  "name": "探春令",
  "aliases": [],
  "description": "此调宋人俱咏初春风景，或咏梅花，故名《探春》。韩淲词有“景龙灯火昇平世”句， 名《景龙灯》。",
  "default_variant": "宋徽宗",
  "default_variant_source_id": 590,
  "variants": [
    {
      "name": "宋徽宗",
      "source_id": 590,
      "length_category": "short",
      "variants_description": "此调有两体，或前段四字三句起，或前段七字一句、五字一句起。此体乃四字三句起者，于中又有前结六字句，后结五字、七字句，或两结皆五字句，或两结皆六字句， 悉以类列，按谱时便于参校也。\n此谱可平可仄悉参类列八词。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          3,
          4,
          5
        ],
        "lines": [
          "中平/中仄",
          "仄平/平仄",
          "中平/平仄",
          "仄平/仄仄/平平仄",
          "仄中仄、平平仄"
        ]
      },
      "stanza2": {
