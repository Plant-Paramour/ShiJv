{
  "name": "沁园春",
  "aliases": [],
  "description": "金词注“般涉调”。蒋氏《十三调》注“中吕调”。张辑词结句有“号我东仙”句， 名《东仙》。李刘词名《寿星明》。秦观减字词名《洞庭春色》。",
  "default_variant": "苏轼",
  "default_variant_source_id": 2163,
