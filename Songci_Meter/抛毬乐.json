{
  "name": "抛毬乐",
  "aliases": [],
  "description": "唐教坊曲名。《唐音癸笺》云：“《抛毬乐》，酒筵中抛毬为令，其所唱之词也。”",
  "default_variant": "刘禹锡",
  "default_variant_source_id": 100,
