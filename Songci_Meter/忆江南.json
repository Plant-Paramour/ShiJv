          "仄平/平仄/仄平平",
          "平仄/仄平平"
        ]
      }
    },
    {
      "name": "冯延巳",
      "source_id": 52,
      "length_category": "medium",
      "variants_description": "按《阳春集》冯词二首前后段俱两平两仄四换韵，实与唐宋《忆江南》本调不同，因调名同，故为类列。",
      "rhyme_type": "平仄转换韵",
