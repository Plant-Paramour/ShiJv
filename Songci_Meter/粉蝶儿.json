{
  "name": "粉蝶儿",
  "aliases": [],
  "description": "调见毛滂《东堂词》。因词有“粉蝶儿，这回共花同活”句，取以为名。金词注“中 吕调”。《太和正音谱》：“中吕宫”。",
  "default_variant": "毛滂",
  "default_variant_source_id": 1063,
