{
  "name": "贺圣朝",
  "aliases": [],
  "description": "唐教坊曲名。《花间集》有欧阳炯词，本名《贺明朝》，《词律》混入《贺圣朝》误。",
  "default_variant": "冯延巳",
  "default_variant_source_id": 412,
  "variants": [
    {
      "name": "冯延巳",
      "source_id": 412,
      "length_category": "short",
      "variants_description": "此调昉自此词，如杜词、黄词、叶词、赵词，皆由此添字或摊破句法，其实同出一原也。若无名氏之《转调贺圣朝》，另押平韵，与此不同，因调名同，故为类列。\n谱内可平可仄悉参后列七词句法同者。",
      "rhyme_type": "仄韵",
      "number_of_stanzas": 2,
      "stanza1": {
        "rhyme_1_positions": [
          1,
          2,
          5
        ],
        "lines": [
